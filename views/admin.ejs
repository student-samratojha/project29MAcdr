<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Project29M</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-slate-50 min-h-screen">
    <!-- Nav (Same Branding as Secure Portal) -->
    <nav class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center gap-3">
                    <div class="h-8 w-8 bg-blue-600 rounded-lg flex items-center justify-center shadow-md shadow-blue-100">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </div>
                    <span class="text-slate-900 font-bold text-xl tracking-tight">Project29M</span>
                    <span class="ml-4 px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">Admin Console</span>
                </div>
                <div class="flex items-center gap-6">
                    <a href="/post/all" class="text-xs font-bold text-slate-500 hover:text-blue-600 transition-colors uppercase tracking-widest">Feed</a>
                    <a href="/secure/adminProfile" class="text-xs font-bold text-slate-500 hover:text-blue-600 transition-colors uppercase tracking-widest">My Profile</a>
                    <div class="h-px w-6 bg-slate-200 rotate-90 hidden sm:block"></div>
                    <a href="/auth/logout" class="text-xs font-bold text-red-500 hover:text-red-600 transition-colors uppercase tracking-widest">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Hero Header -->
        <div class="mb-8">
            <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 mb-2">System <span class="text-blue-600">Management</span></h1>
            <p class="text-lg text-slate-500 font-medium">Global oversight of users, content, and security protocols.</p>
        </div>

        <!-- Quick Stats Summary (Data from Controller) -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Total Users</p>
                <p class="text-3xl font-extrabold text-slate-900"><%= users.length %></p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Active Posts</p>
                <p class="text-3xl font-extrabold text-blue-600"><%= posts.length %></p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Total Comments</p>
                <p class="text-3xl font-extrabold text-slate-900"><%= comments.length %></p>
            </div>
            <div class="bg-blue-600 p-6 rounded-2xl shadow-lg shadow-blue-100">
                <p class="text-[10px] font-bold text-blue-200 uppercase tracking-widest mb-1">System Health</p>
                <p class="text-3xl font-extrabold text-white">99.2%</p>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-8">
            <!-- Users Table Section -->
            <section class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-6 py-5 border-b border-slate-200 bg-white">
                    <h2 class="text-xl font-bold text-slate-900">User Directory</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr>
                                <th class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest border-b border-slate-100">User</th>
                                <th class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest border-b border-slate-100">Role</th>
                                <th class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest border-b border-slate-100">Status</th>
                                <th class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest border-b border-slate-100 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            <% users.forEach(u => { %>
                            <tr class="hover:bg-slate-50/30 transition-colors">
                                <td class="px-6 py-4 flex items-center gap-3">
                                    <div class="h-10 w-10 rounded-xl overflow-hidden border border-slate-200">
                                        <img src="<%= u.profilePic || 'https://campussafetyconference.com/wp-content/uploads/2020/08/iStock-476085198.jpg' %>" alt="<%= u.name %>" class="h-full w-full object-cover">
                                    </div>
                                    <div>
                                        <div class="font-bold text-slate-900"><%= u.name %></div>
                                    <div class="text-xs text-slate-500"><%= u.email %></div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded-lg <%= u.role === 'admin' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700' %>">
                                        <%= u.role %>
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <% if(u.isDeleted) { %>
                                        <span class="flex items-center text-red-600 text-sm">
                                            <span class="h-1.5 w-1.5 rounded-full bg-red-600 mr-2"></span> Deleted
                                        </span>
                                    <% } else { %>
                                        <span class="flex items-center text-emerald-600 text-sm">
                                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-600 mr-2"></span> Active
                                        </span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <% if(u._id.toString() !== user._id.toString()) { %>
                                        <div class="flex items-center justify-end gap-2">
                                            <a href="/secure/edit/<%= u._id %>" class="px-3 py-1.5 bg-white text-slate-700 text-[10px] font-bold rounded-lg border border-slate-200 hover:bg-slate-50 transition-all shadow-sm">EDIT</a>
                                            <form action="/secure/<%= u.isDeleted ? 'restore' : 'delete' %>" method="POST" class="inline">
                                            <input type="hidden" name="id" value="<%= u._id %>">
                                                <button type="submit" class="px-3 py-1.5 rounded-lg text-[10px] font-bold transition-all shadow-sm <%= u.isDeleted ? 'bg-blue-600 text-white hover:bg-blue-700 shadow-blue-100' : 'bg-white text-red-600 border border-red-100 hover:bg-red-50' %>">
                                                    <%= u.isDeleted ? 'RESTORE' : 'DELETE' %>
                                            </button>
                                        </form>
                                        </div>
                                    <% } else { %>
                                        <span class="text-xs text-slate-400 italic">Self</span>
                                    <% } %>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Audit Logs Section -->
            <section class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="px-6 py-5 border-b border-slate-200 bg-white flex justify-between items-center">
                    <h2 class="text-xl font-bold text-slate-900">Security Audit Logs</h2>
                    <span class="text-xs text-slate-400">Last 10 events</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr>
                                <th class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest border-b border-slate-100">Timestamp</th>
                                <th class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest border-b border-slate-100">User</th>
                                <th class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest border-b border-slate-100">Action</th>
                                <th class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest border-b border-slate-100">IP Address</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            <% audits.forEach(log => { %>
                            <tr class="text-sm">
                                <td class="px-6 py-3 text-slate-500 font-mono text-xs">
                                    <%= new Date(log.createdAt).toLocaleString() %>
                                </td>
                                <td class="px-6 py-3">
                                    <% if(log.user) { %>
                                        <div class="font-bold text-slate-800"><%= log.user.name %></div>
                                    <% } else { %>
                                        <span class="text-slate-400 italic">Anonymous</span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-3">
                                    <div class="text-slate-900"><%= log.action %></div>
                                    <div class="text-xs text-slate-400"><%= log.route %></div>
                                </td>
                                <td class="px-6 py-3 text-slate-500">
                                    <%= log.ip %>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>
    
    <footer class="py-12 text-center text-slate-400 text-xs font-bold uppercase tracking-widest">
        &copy; 2024 Project29M &bull; Encrypted Session Administration
    </footer>
</body>
</html>